{
  "schemaVersion": 1,
  "name": "WoodenFish",
  "author": "Antigravity & User",
  "version": "1.0.0",
  "description": "Sacred authentic wooden fish desktop pet with pure SVG animations, continuous soothing knocking and floating merit +1 effects.",
  "viewBox": {
    "x": -25,
    "y": -25,
    "width": 50,
    "height": 50
  },
  "layout": {
    "contentBox": {
      "x": -13,
      "y": -11,
      "width": 26,
      "height": 29
    },
    "centerX": 0,
    "baselineY": 18,
    "visibleHeightRatio": 0.4,
    "baselineBottomRatio": 0.05
  },
  "eyeTracking": {
    "enabled": false
  },
  "states": {
    "idle": [
      "idle-follow.svg"
    ],
    "roam": [
      "roam.svg"
    ],
    "working": [
      "working.svg"
    ],
    "thinking": [
      "thinking.svg"
    ],
    "sleeping": [
      "sleeping.svg"
    ],
    "notification": [
      "notification.svg"
    ],
    "attention": {
      "fallbackTo": "notification"
    },
    "error": [
      "error.svg"
    ],
    "waking": [
      "idle-follow.svg"
    ]
  },
  "sleepSequence": {
    "mode": "direct"
  },
  "hitBoxes": {
    "default": {
      "x": -13,
      "y": -11,
      "w": 26,
      "h": 29
    },
    "sleeping": {
      "x": -13,
      "y": 5,
      "w": 26,
      "h": 13
    }
  }
}
