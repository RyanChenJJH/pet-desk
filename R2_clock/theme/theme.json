{
  "schemaVersion": 1,
  "name": "ClockRobot",
  "author": "Antigravity & User",
  "version": "1.0.0",
  "description": "Retro twin-bell clockwork robot with eye-tracking dial, walking rhythm, fast-spinning gears and alarm rings.",
  "viewBox": {
    "x": -20,
    "y": -25,
    "width": 50,
    "height": 50
  },
  "layout": {
    "contentBox": {
      "x": -8,
      "y": -12,
      "width": 26,
      "height": 30
    },
    "centerX": 5,
    "baselineY": 18,
    "visibleHeightRatio": 0.52,
    "baselineBottomRatio": 0.05
  },
  "eyeTracking": {
    "enabled": true,
    "states": [
      "idle"
    ],
    "eyeRatioX": 0.45,
    "eyeRatioY": 0.45,
    "maxOffset": 2.2,
    "bodyScale": 0.2,
    "shadowStretch": 0.12,
    "shadowShift": 0.2,
    "ids": {
      "eyes": "eyes-js",
      "body": "body-js",
      "shadow": "shadow-js"
    },
    "shadowOrigin": "5px 18px"
  },
  "states": {
    "idle": [
      "idle-follow.svg"
    ],
    "roam": [
      "roam.svg"
    ],
    "thinking": [
      "thinking.svg"
    ],
    "working": [
      "working.svg"
    ],
    "notification": [
      "notification.svg"
    ],
    "sleeping": [
      "sleeping.svg"
    ],
    "attention": {
      "fallbackTo": "notification"
    },
    "error": {
      "fallbackTo": "thinking"
    },
    "waking": [
      "idle-follow.svg"
    ]
  },
  "sleepSequence": {
    "mode": "direct"
  },
  "hitBoxes": {
    "default": {
      "x": -7,
      "y": -10,
      "w": 24,
      "h": 28
    },
    "sleeping": {
      "x": -7,
      "y": 2,
      "w": 24,
      "h": 16
    }
  }
}
