{
  "schemaVersion": 1,
  "name": "Dabaixiong",
  "author": "Antigravity & User",
  "version": "1.1.0",
  "description": "Faithful to original art: cylindrical white bear with wide-set bead eyes, drooping bangs, shoulder straps, typing with sparks and snot bubble sleep.",
  "viewBox": {
    "x": -25,
    "y": -25,
    "width": 50,
    "height": 50
  },
  "layout": {
    "contentBox": {
      "x": -13,
      "y": -16,
      "width": 26,
      "height": 28
    },
    "centerX": 0,
    "baselineY": 18,
    "visibleHeightRatio": 0.42,
    "baselineBottomRatio": 0.05
  },
  "eyeTracking": {
    "enabled": true,
    "states": [
      "idle"
    ],
    "eyeRatioX": 0.45,
    "eyeRatioY": 0.45,
    "maxOffset": 2.2,
    "bodyScale": 0.18,
    "shadowStretch": 0.12,
    "shadowShift": 0.2,
    "ids": {
      "eyes": "eyes-js",
      "body": "body-js",
      "shadow": "shadow-js"
    },
    "shadowOrigin": "0px 18px"
  },
  "states": {
    "idle": [
      "idle-follow.svg"
    ],
    "roam": [
      "roam.svg"
    ],
    "thinking": [
      "thinking.svg"
    ],
    "working": [
      "working.svg"
    ],
    "notification": [
      "notification.svg"
    ],
    "sleeping": [
      "sleeping.svg"
    ],
    "attention": {
      "fallbackTo": "notification"
    },
    "error": {
      "fallbackTo": "thinking"
    },
    "sweeping": {
      "fallbackTo": "working"
    },
    "carrying": {
      "fallbackTo": "roam"
    },
    "waking": [
      "idle-follow.svg"
    ]
  },
  "sleepSequence": {
    "mode": "direct"
  },
  "hitBoxes": {
    "default": {
      "x": -13,
      "y": -16,
      "w": 26,
      "h": 34
    },
    "sleeping": {
      "x": -13,
      "y": -8,
      "w": 26,
      "h": 26
    }
  }
}